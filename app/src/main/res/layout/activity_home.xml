<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/noctis_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Nombre de la app-->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="@color/noctis_text"
        android:textSize="36sp"
        android:textStyle="bold" />


    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:text="@string/app_motto"
        android:textColor="@color/noctis_text_secondary"
        android:textSize="16sp" />


    <Button
        android:id="@+id/btnMiNoche"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="@string/btn_mi_noche" />

    <Button
        android:id="@+id/btnAdaptacion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="@string/btn_adaptacion" />

    <Button
        android:id="@+id/btnAcercaDe"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:text="@string/btn_acerca_de" />


    <TextView
        android:id="@+id/tvEstadoAdaptacion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/resultado_pendiente"
        android:textColor="@color/noctis_text_secondary"
        android:textSize="14sp" />

</LinearLayout>
