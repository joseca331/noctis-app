<?xml version="1.0" encoding="utf-8"?>





<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/noctis_fondo"
    android:fitsSystemWindows="true"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Logotipo: la estrella. contentDescription lo describe a los lectores de pantalla -->
    <ImageView
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:contentDescription="@string/desc_logo"
        android:src="@drawable/ic_estrella" />

    <!-- Nombre de la app (el tamaño va en sp para respetar la letra grande del usuario) -->
    <TextView
        android:id="@+id/txtTitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/app_name"
        android:textColor="@color/noctis_texto"
        android:textSize="36sp"
        android:textStyle="bold" />

    <!-- Lema; el margen inferior lo separa de los botones -->
    <TextView
        android:id="@+id/txtLema"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:text="@string/lema"
        android:textColor="@color/noctis_texto"
        android:textSize="16sp" />

    <!-- Botón 1: Mi noche. minHeight 48dp = área táctil mínima recomendada -->
    <Button
        android:id="@+id/btnMiNoche"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="@string/btn_mi_noche" />

    <!-- Botón 2: Adaptación ocular -->
    <Button
        android:id="@+id/btnAdaptacion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:minHeight="48dp"
        android:text="@string/btn_adaptacion_ocular" />

    <!-- Botón 3: Acerca de -->
    <Button
        android:id="@+id/btnAcercaDe"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:minHeight="48dp"
        android:text="@string/btn_acerca_de" />
</LinearLayout>