<?xml version="1.0" encoding="utf-8"?>





<!-- Raíz: LinearLayout vertical. Apila título, tarjetas, espacio y botones de arriba abajo -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/noctis_fondo"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Título de la pantalla -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/titulo_mi_noche"
        android:textColor="@color/noctis_acento"
        android:textSize="28sp"
        android:textStyle="bold" />

    <!-- Fila de tarjetas: horizontal. Cada tarjeta tiene ancho 0dp y peso 1,
         así las tres se reparten el ancho por igual -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <!-- Tarjeta 1: hora -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/fondo_tarjeta"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/etiqueta_hora"
                android:textColor="@color/noctis_texto_suave"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/valor_hora_prueba"
                android:textColor="@color/noctis_texto"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Tarjeta 2: lugar (marginStart separa las tarjetas) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/fondo_tarjeta"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/etiqueta_lugar"
                android:textColor="@color/noctis_texto_suave"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/valor_lugar_prueba"
                android:textColor="@color/noctis_texto"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Tarjeta 3: índice de oscuridad -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/fondo_tarjeta"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/etiqueta_oscuridad"
                android:textColor="@color/noctis_texto_suave"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/valor_oscuridad_prueba"
                android:textColor="@color/noctis_texto"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Espacio flexible: alto 0dp y peso 1, ocupa todo el alto que sobra
         y empuja los botones hacia abajo -->
    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Fila de botones: pesos 2, 1 y 1, el primero ocupa el doble de ancho -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnBrujula"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:minHeight="48dp"
            android:text="@string/btn_brujula" />

        <Button
            android:id="@+id/btnDiario"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:text="@string/btn_diario" />

        <Button
            android:id="@+id/btnAjustes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:text="@string/btn_ajustes" />
    </LinearLayout>
</LinearLayout>