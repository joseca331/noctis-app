<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/noctis_bg"
    android:padding="24dp">

    <!-- Capa Icono de esfera centrado -->
    <ImageView
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_gravity="center"
        android:contentDescription="@string/titulo_brujula"


    android:src="@mipmap/ic_launcher" />

    <!-- Capa: Texto del rumbo superpuesto en el centro -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@color/noctis_card"
        android:padding="8dp"
        android:text="@string/brujula_rumbo"
        android:textColor="@color/noctis_text"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- Capa Aviso superior que cambia  -->
    <TextView
        android:id="@+id/tvAvisoCalibrando"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@color/noctis_warning"
        android:gravity="center"
        android:padding="12dp"
        android:text="@string/brujula_calibrando"
        android:textColor="@color/noctis_text"
        android:textStyle="bold"
        android:visibility="visible" />

    <!-- Capa : Botón inferior -->
    <Button
        android:id="@+id/btnToggleCalibracion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:text="@string/btn_toggle_calibracion" />

</FrameLayout>
