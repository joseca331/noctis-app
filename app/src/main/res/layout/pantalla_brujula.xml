<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/noctis_fondo"
    android:fitsSystemWindows="true">

    <!-- la esfera, centrada. Lleva contentDescription por accesibilidad -->
    <ImageView
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:layout_gravity="center"
        android:contentDescription="@string/desc_esfera"
        android:src="@drawable/ic_esfera" />


    <TextView
        android:id="@+id/txtRumbo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="@string/rumbo_prueba"
        android:textColor="@color/noctis_texto"
        android:textSize="32sp"
        android:textStyle="bold" />

    <!--aviso «Calibrando…» arriba y centrado.
         Empieza visible; el botón de abajo lo muestra y lo oculta -->
    <TextView
        android:id="@+id/txtCalibrando"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="24dp"
        android:background="@drawable/fondo_tarjeta"
        android:padding="12dp"
        android:text="@string/aviso_calibrando"
        android:textColor="@color/noctis_acento"
        android:textSize="16sp"
        android:visibility="visible" />

    <!-- botón abajo y centrado que alterna el aviso -->
    <Button
        android:id="@+id/btnAlternarAviso"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="24dp"
        android:minHeight="48dp"
        android:text="@string/btn_alternar_aviso" />
</FrameLayout>